{
    "manifest_version": 3,
    "name": "EDUSRC助手",
    "version": "1.4.1",
    "description": "助力学生更高效地使用EDUSRC平台，支持礼品搜索、已兑换过滤与可兑换检测",
    "icons": {
        "16": "favicon.png",
        "48": "favicon.png",
        "128": "favicon.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://src.sjtu.edu.cn/gift/",
                "*://src.sjtu.edu.cn/gift/?*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}